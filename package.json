{
  "name": "auto-crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @auto-crm/crm dev",
    "build": "pnpm --filter @auto-crm/crm build",
    "preview": "pnpm --filter @auto-crm/crm preview",
    "type-check": "tsc -p tsconfig.json && pnpm -r type-check",
    "lint": "eslint --cache --max-warnings 0 .",
    "lint:fix": "eslint --cache --fix ."
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
