{
  "name": "auto-crm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @auto-crm/crm dev",
    "build": "pnpm --filter @auto-crm/crm build",
    "preview": "pnpm --filter @auto-crm/crm preview",
    "type-check": "tsc -p tsconfig.json && pnpm -r type-check",
    "lint": "eslint --cache --max-warnings 0 .",
    "lint:fix": "eslint --cache --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "sh scripts/setup-git-hooks.sh"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsonc-eslint-parser": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
